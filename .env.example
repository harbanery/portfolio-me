# =============================================================================
# 🚀 PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# File        : .env.production
# Description : Production configuration for Portfolio Website
# Notes       :
#   - Use `.env.development` for local development
#   - Never expose SECRET keys to the client/browser
#   - Variables prefixed with `NEXT_PUBLIC_` are exposed publicly
# =============================================================================


# =============================================================================
# 🌐 APPLICATION
# =============================================================================

# Website title (browser tab / SEO title)
TITLE_WEB="Kimi No Nawa's Portfolio"

# Application name
APP_WEB="My Portfolio"

# Website description for SEO/meta tags
DESCRIPTION_WEB="Welcome to my personal portfolio website."

# Public base URL
NEXT_PUBLIC_URL="http://localhost:3000"

# Public API endpoint
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"


# =============================================================================
# 🗄️ DATABASE (PostgreSQL)
# =============================================================================
# DATABASE_URL  : Used by the application runtime
# DIRECT_URL    : Used for Prisma migrations / direct DB access

# Production Database Connection
DATABASE_URL="postgresql://[user]:[password]@[host]:[port]/[database]"

# Direct Database Connection
DIRECT_URL="postgresql://[user]:[password]@[host]:[port]/[database]"


# =============================================================================
# 🔐 ADMIN ACCESS
# =============================================================================
# Enable or disable admin panel access
# true  = /admin accessible
# false = /admin returns 404

ACCESS_ADMIN="true"


# =============================================================================
# 📦 SUPABASE CONFIGURATION
# =============================================================================
# Used for authentication, storage, or backend services

# Public Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public anonymous key (safe for frontend usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Service role key (SERVER ONLY - KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"


# =============================================================================
# ☁️ CLOUDINARY CONFIGURATION
# =============================================================================
# Used for media uploads and image hosting

# Public Cloudinary Cloud Name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"

# Public upload preset
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="YOUR_CLOUDINARY_PRESET"

# Server-side credentials
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"


# =============================================================================
# 🚂 RAILWAY STORAGE CONFIGURATION
# =============================================================================
# Used for Railway object storage / bucket

# Public storage endpoint
NEXT_PUBLIC_RAILWAY_BUCKET_URL="https://your-railway.storageapi.dev"

# Public bucket name
NEXT_PUBLIC_RAILWAY_BUCKET_NAME="YOUR_RAILWAY_BUCKET_NAME"

# Private API credentials
RAILWAY_BUCKET_API_KEY="YOUR_RAILWAY_BUCKET_API_KEY"
RAILWAY_BUCKET_API_SECRET="YOUR_RAILWAY_BUCKET_API_SECRET"


# =============================================================================
# 🔒 SECURITY NOTES
# =============================================================================
# DO NOT expose these variables to the frontend:
# - SUPABASE_SERVICE_ROLE_KEY
# - CLOUDINARY_API_SECRET
# - RAILWAY_BUCKET_API_SECRET
# - DATABASE_URL
# - DIRECT_URL
#
# Recommended:
# - Store secrets in Railway / Vercel Environment Variables
# - Do not commit real secrets to GitHub
# - Rotate keys regularly if already exposed publicly
# =============================================================================