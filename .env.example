# =============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to `.env` and fill in the values.
# Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser.
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================

# Website title (browser tab / SEO title)
TITLE_WEB="Raihan Yusuf's Portfolio"

# Application name
APP_WEB="Raihan Yusuf"

# Website description for SEO/meta tags
DESCRIPTION_WEB="Personal portfolio of Raihan Yusuf — projects, experience, and contacts."

# Public base URL (used for metadata / Open Graph)
NEXT_PUBLIC_URL="http://localhost:3000"

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# DATABASE_URL : Used by the application runtime (pooled connection)
# DIRECT_URL   : Used for Prisma migrations / direct DB access

DATABASE_URL="postgresql://user:password@host:5432/database"

DIRECT_URL="postgresql://user:password@host:5432/database"
