# =============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to `.env` and fill in the values.
# Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser.
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================

# Website title (browser tab / SEO title)
TITLE_WEB="Raihan Yusuf's Portfolio"

# Application name
APP_WEB="Raihan Yusuf"

# Website description for SEO/meta tags
DESCRIPTION_WEB="Personal portfolio of Raihan Yusuf — projects, experience, and contacts."

# Public base URL (used for metadata / Open Graph)
NEXT_PUBLIC_URL="http://localhost:3000"

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# DATABASE_URL : Used by the application runtime (pooled connection)
# DIRECT_URL   : Used for Prisma migrations / direct DB access

DATABASE_URL="************************************/database"

DIRECT_URL="************************************/database"

# =============================================================================
# EMAIL (SMTP via Nodemailer) — contact form delivery
# =============================================================================
# Same pattern as progress-self. Messages are delivered to the personal
# contact email (type "mail") stored in the database — no recipient env
# var. When SMTP_HOST is empty, the contact endpoint reports email as
# unavailable (503) instead of failing silently.

SMTP_HOST=""
SMTP_PORT="465"
# Direct TLS on port 465; STARTTLS for other ports (e.g. 587). Defaults to
# true when port is 465.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Sender address — falls back to SMTP_USER when empty.
SMTP_FROM=""
