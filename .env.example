# ============================================================
# Environment Variables Template
# ============================================================
# Copy this file to:
#   - .env for production
#   - .env.development for development

TITLE_WEB="Your Portfolio Name"
APP_WEB="My Portfolio"
DESCRIPTION_WEB="Welcome to my personal portfolio website."

NEXT_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"

# ============================================================
# Database Configuration
# ============================================================
# For Production: use schema=portfolio
# For Development: use schema=portfolio-dev

# Transaction mode for connection pooler (port 6543)
DATABASE_URL="postgresql://[user]:[password]@[host]:6543/postgres?pgbouncer=true&schema=portfolio"

# Direct connection for migrations (port 5432)
DIRECT_URL="postgresql://[user]:[password]@[host]:5432/postgres?schema=portfolio"

# ============================================================
# Admin & Security
# ============================================================
ACCESS_ADMIN="true"

# ============================================================
# Supabase Configuration
# ============================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
