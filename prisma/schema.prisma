generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PortfolioStatus {
  ACTIVE
  NONACTIVE
}

model Personal {
  id        Int       @id @default(autoincrement())
  name      String
  about     String?
  skills    String[]
  contacts  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Portfolio {
  id          Int             @id @default(autoincrement())
  title       String
  role        String
  image       String
  description String?
  skills      String[]
  repoLinks   String[]        @map("repo_links")
  webLink     String?         @map("web_link")
  status      PortfolioStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}
